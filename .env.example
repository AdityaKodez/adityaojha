# GitHub API Token (Optional: enables GitHub commits & contributions section)
GITHUB_TOKEN=

# Discord User ID for presence widget (Optional: falls back to default ID)
DISCORD_USER_ID=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Web Analytics API (powers the footer visitor counter; Optional: counter hides when missing)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Discord webhook that receives component suggestions (Required for the suggest dialog on /components)
DISCORD_COMPONENT_SUGGESTION_WEBHOOK_URL=

# TypeSafe API key, runs Jev moderation on suggestions (Optional: heuristic checks only when missing)
TYPESAFE_API_KEY=

# Google Search Console verification token (Optional: skips the meta tag when missing)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Dodo Payments API key (Required for sponsor checkout and claim routes; claim degrades when missing)
DODO_PAYMENTS_API_KEY=

# Dodo Payments webhook signing key (Required: webhook rejects everything with 500 when missing, so Dodo retries)
DODO_WEBHOOK_KEY=

# GitHub token that lets paid sponsor seats be committed (Optional: paid seats cannot be committed when missing)
SPONSOR_GITHUB_TOKEN=

# Repo the sponsor store seeds (Optional: defaults to AdityaKodez/adityaojha)
SPONSOR_REPO_OWNER=
SPONSOR_REPO_NAME=

# Dodo Payments product id for an orbit seat (Optional: checkout sessions cannot be created, CTA degrades when missing)
DODO_ORBIT_SEAT_PRODUCT_ID=

# Set to "test" to hit test.dodopayments.com (Optional)
DODO_PAYMENTS_MODE=
