# GitHub API Token (Optional: enables GitHub commits & contributions section)
GITHUB_TOKEN=

# Discord User ID for presence widget (Optional: falls back to default ID)
DISCORD_USER_ID=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vercel Web Analytics API (powers the footer visitor counter; Optional: counter hides when missing)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
